---
/**
 * Cortex Desktop download buttons (macOS arm64 + Windows .exe).
 *
 * 链接直指自建 CDN download.hiq.earth（AWS S3 + CloudFront，中国不被墙）：
 *   latest/Cortex-arm64.dmg / latest/Cortex-Setup.exe —— 稳定名，每版发布由 CI
 *   覆盖（cortex 仓 desktop-release.yml 的 mirror-cdn job），官网链接永不需改。
 *
 * 之前 mac 走 GitHub API 查最新 .dmg、win 硬编码 github releases —— 两者都撞被墙
 * 的 GitHub，中国用户下载失败。改直链 CDN 后不再需要 BaseLayout 里那段 mac 解析 JS。
 *
 * Both anchors render in the parent flex container; no wrapper element.
 */

interface Props {
  locale?: 'en' | 'zh';
  /** 'mac' makes the macOS button primary (filled), Windows secondary (ghost).
   *  'ghost' makes both secondary — for inline / cluster placements. */
  primary?: 'mac' | 'ghost';
}

const { locale = 'en', primary = 'mac' } = Astro.props;

const labels = {
  en: { mac: 'Download for macOS', win: 'Download for Windows' },
  zh: { mac: '下载 macOS 版', win: '下载 Windows 版' },
}[locale];

const macClass = primary === 'mac' ? 'ticket' : 'ticket-ghost';
const winClass = 'ticket-ghost';

const MAC_DIRECT = 'https://download.hiq.earth/latest/Cortex-arm64.dmg';
const WIN_DIRECT = 'https://download.hiq.earth/latest/Cortex-Setup.exe';
---

<a href={MAC_DIRECT} class={macClass}>
  {labels.mac} <span aria-hidden="true">→</span>
</a>
<a href={WIN_DIRECT} class={winClass}>
  {labels.win} <span aria-hidden="true">→</span>
</a>
