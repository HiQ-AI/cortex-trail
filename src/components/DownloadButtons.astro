---
/**
 * Cortex Desktop download buttons (macOS arm64 + Windows .exe).
 *
 * macOS: data-cortex-download="mac" — global click handler in BaseLayout
 *   fetches GitHub API for the latest .dmg asset and redirects directly.
 *   Falls back to the GitHub release page if the API is unreachable.
 * Windows: hardcoded to releases/latest/download/Cortex-Setup.exe —
 *   electron-builder publishes that file without a version suffix, so
 *   GitHub's stable redirect always points to the latest build.
 *
 * Both anchors render in the parent flex container; no wrapper element.
 */

interface Props {
  locale?: 'en' | 'zh';
  /** 'mac' makes the macOS button primary (filled), Windows secondary (ghost).
   *  'ghost' makes both secondary — for inline / cluster placements. */
  primary?: 'mac' | 'ghost';
}

const { locale = 'en', primary = 'mac' } = Astro.props;

const labels = {
  en: { mac: 'Download for macOS', win: 'Download for Windows' },
  zh: { mac: '下载 macOS 版', win: '下载 Windows 版' },
}[locale];

const macClass = primary === 'mac' ? 'ticket' : 'ticket-ghost';
const winClass = primary === 'mac' ? 'ticket-ghost' : 'ticket-ghost';

const WIN_DIRECT = 'https://github.com/HiQ-AI/cortex-desktop/releases/latest/download/Cortex-Setup.exe';
const RELEASES_FALLBACK = 'https://github.com/HiQ-AI/cortex-desktop/releases/latest';
---

<a href={RELEASES_FALLBACK} class={macClass} data-cortex-download="mac">
  {labels.mac} <span aria-hidden="true">→</span>
</a>
<a href={WIN_DIRECT} class={winClass} data-cortex-download="win">
  {labels.win} <span aria-hidden="true">→</span>
</a>
