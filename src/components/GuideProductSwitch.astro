---
interface Props { locale?: 'en' | 'zh'; product: 'chat' | 'cowork' }
const { locale = 'en', product } = Astro.props;
const base = locale === 'zh' ? '/zh/guides' : '/guides';
---
<nav class="guide-product-switch" aria-label={locale === 'zh' ? '选择产品指南' : 'Product guides'}>
  <a href={`${base}/`} aria-current={product === 'chat' ? 'page' : undefined}>Chat</a>
  <a href={`${base}/cowork/`} aria-current={product === 'cowork' ? 'page' : undefined}>Cowork</a>
</nav>
<style>
.guide-product-switch { display: flex; gap: 4px; padding: 4px; width: fit-content; background: var(--paper-rim); border: 1px solid var(--rule); border-radius: 8px; }
a { padding: 8px 24px; border-radius: 5px; text-decoration: none; color: var(--ink-mute); font-size: 14px; }
a[aria-current] { background: var(--paper); color: var(--shell); box-shadow: 0 1px 3px #00000012; }
a:focus-visible { outline: 2px solid var(--shell); outline-offset: 2px; }
</style>
