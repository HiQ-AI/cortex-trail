---
import '@/styles/global.css';
import SiteHead from '@/components/SiteHead.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

interface Props {
  title: string;
  description: string;
  locale?: 'en' | 'zh';
  canonical?: string;
  ogImage?: string;
}

const { title, description, locale = 'en', canonical, ogImage } = Astro.props;
const lang = locale === 'zh' ? 'zh-CN' : 'en';
---

<!doctype html>
<html lang={lang} class="h-full">
  <head>
    <SiteHead title={title} description={description} canonical={canonical} ogImage={ogImage} />
    <script is:inline define:vars={{ pageLocale: locale }}>
      // Language preference persistence.
      // 1. Save current page's locale to localStorage so future root visits remember.
      // 2. On root paths, if remembered locale is 'zh' and we're on EN, redirect to ZH.
      try {
        if (pageLocale === 'zh' || pageLocale === 'en') {
          localStorage.setItem('cortex.locale', pageLocale);
        }
        const path = window.location.pathname.replace(/\/$/, '') || '/';
        const stored = localStorage.getItem('cortex.locale');
        if (stored === 'zh' && pageLocale === 'en' && (path === '' || path === '/')) {
          window.location.replace('/zh');
        } else if (stored === 'en' && pageLocale === 'zh' && path === '/zh') {
          // do nothing — user explicitly clicked into /zh; that itself updates the pref
        }
      } catch (_) { /* localStorage unavailable, continue */ }
    </script>
    <script is:inline>
      // Cortex Desktop macOS download — fetch latest .dmg URL on click.
      // Windows button is a hardcoded direct link (handled by browser).
      (function () {
        const API = 'https://api.github.com/repos/HiQ-AI/cortex-desktop/releases/latest';
        const FALLBACK = 'https://github.com/HiQ-AI/cortex-desktop/releases/latest';
        const CACHE_KEY = 'cortex.macDmgUrl';
        const CACHE_TTL = 60 * 60 * 1000; // 1h

        async function resolveMacDmgUrl() {
          try {
            const raw = localStorage.getItem(CACHE_KEY);
            if (raw) {
              const cached = JSON.parse(raw);
              if (cached && Date.now() - cached.ts < CACHE_TTL && cached.url) {
                return cached.url;
              }
            }
          } catch (_) { /* cache unreadable, fall through */ }

          const r = await fetch(API, { headers: { Accept: 'application/vnd.github+json' } });
          if (!r.ok) throw new Error('github api ' + r.status);
          const data = await r.json();
          // Match macOS Apple Silicon .dmg (matches Cortex-X.Y.Z-arm64.dmg).
          const asset = (data.assets || []).find(function (a) {
            return /arm64.*\.dmg$/i.test(a.name);
          }) || (data.assets || []).find(function (a) {
            return /\.dmg$/i.test(a.name);
          });
          if (!asset) throw new Error('no dmg asset');
          try {
            localStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), url: asset.browser_download_url }));
          } catch (_) { /* storage full / blocked, ignore */ }
          return asset.browser_download_url;
        }

        document.addEventListener('click', function (e) {
          const a = e.target && e.target.closest && e.target.closest('a[data-cortex-download="mac"]');
          if (!a) return;
          e.preventDefault();
          resolveMacDmgUrl()
            .then(function (url) { window.location.href = url; })
            .catch(function () { window.location.href = FALLBACK; });
        });
      })();
    </script>
  </head>
  <body class="flex min-h-full flex-col font-serif" style="font-variation-settings: 'opsz' 16;">
    <Header locale={locale} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
