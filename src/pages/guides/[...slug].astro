---
import { getCollection, render } from 'astro:content';
import GuidesShell from '@/components/GuidesShell.astro';

// Section display order. Any section not listed falls to the end, alphabetically.
const SECTION_ORDER = ['Start here', 'Workflows'];

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => data.locale === 'en');
  return docs.map((doc) => ({
    params: { slug: doc.id },
    props: { doc, all: docs },
  }));
}

const { doc, all } = Astro.props;
const { Content } = await render(doc);

const sectionRank = (name: string) => {
  const i = SECTION_ORDER.indexOf(name);
  return i === -1 ? SECTION_ORDER.length : i;
};

const grouped = new Map<string, typeof all>();
for (const d of all) {
  const key = d.data.section;
  if (!grouped.has(key)) grouped.set(key, []);
  grouped.get(key)!.push(d);
}

const sections = [...grouped.entries()]
  .sort(([a], [b]) => sectionRank(a) - sectionRank(b) || a.localeCompare(b))
  .map(([title, items]) => ({
    title,
    items: items
      .sort((x, y) => x.data.order - y.data.order)
      .map((d) => ({
        href: `/guides/${d.id}`,
        label: d.data.title,
        active: d.id === doc.id,
      })),
  }));

// Scenarios live as bespoke pages at /solutions/* but belong to the Guides hub.
sections.push({
  title: 'Scenarios',
  items: [
    { href: '/solutions/bom-matching', label: 'BOM matching', active: false },
    { href: '/solutions/product-carbon-footprint', label: 'Product carbon footprint', active: false },
    { href: '/solutions/lca-dataset-authoring', label: 'Dataset authoring', active: false },
    { href: '/solutions/ilcd-validation', label: 'ILCD validation', active: false },
    { href: '/solutions/epd-audit', label: 'EPD audit', active: false },
  ],
});
---

<GuidesShell
  locale="en"
  title={doc.data.title}
  description={doc.data.description}
  sections={sections}
  guidesHref="/guides"
  guidesLabel="Guides"
>
  <Content />
</GuidesShell>
