---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import GuideProductSwitch from '@/components/GuideProductSwitch.astro';
import SectionMark from '@/components/SectionMark.astro';

const title = 'Guides — HiQ Cortex';
const description =
  'How to use Cortex, end to end — from your first query to a finished calculation, plus worked scenarios you can watch run.';

const SECTION_ORDER = ['Start here', 'Workflows'];
const rank = (n: string) => {
  const i = SECTION_ORDER.indexOf(n);
  return i === -1 ? SECTION_ORDER.length : i;
};

const product = Astro.props.product ?? 'chat';
const docs = (await getCollection('docs', ({ id, data }) => data.locale === 'en' && id.startsWith('cowork/') === (product === 'cowork'))).sort(
  (a, b) => rank(a.data.section) - rank(b.data.section) || a.data.order - b.data.order,
);

const practitioner = [
  { href: '/solutions/bom-matching', label: 'BOM matching', blurb: 'BOM in, matched xlsx out — every dataset cell a hyperlink, every gap flagged.' },
  { href: '/solutions/product-carbon-footprint', label: 'Product carbon footprint', blurb: 'From BOM to LCIA results inside openLCA, every modeling decision recorded.' },
  { href: '/solutions/lca-dataset-authoring', label: 'Dataset authoring', blurb: 'Build an ILCD-clean dataset with provenance the reviewer can follow.' },
  { href: '/solutions/ilcd-validation', label: 'ILCD validation', blurb: 'Check a dataset against the format before it reaches a reviewer.' },
  { href: '/product/cowork#computer-use', label: 'Computer Use (macOS)', blurb: 'No API, no plugin? Cortex drives the desktop tool through its GUI.' },
];
const operator = [
  { href: '/solutions/epd-audit', label: 'EPD audit', blurb: 'Check an EPD submission against the clause before it registers.' },
];
---

<BaseLayout title={title} description={description}>
  <section class="relative">
    <div class="container-page pt-6 md:pt-8 pb-8 md:pb-10">
      <div class="mb-6 flex items-center justify-between gap-4 border-b border-rule pb-4">
        <GuideProductSwitch locale="en" product={product} />
        <p class="running-footer hidden whitespace-nowrap sm:block">{new Date().toISOString().slice(0, 10)}</p>
      </div>
      <h1 class="font-display" style="font-size: clamp(2.2rem, 5.5vw, 4.5rem); line-height: 1.05; letter-spacing: -0.02em; font-variation-settings: 'SOFT' 40, 'opsz' 144; font-weight: 400;">
        {product === 'chat' ? 'Chat guides' : 'Cowork guides'}
      </h1>
      <p class="mt-5 max-w-2xl font-serif italic" style="font-size: 1.18rem; line-height: 1.55; font-variation-settings: 'opsz' 20; color: var(--ink-mute);">
        {product === 'chat' ? 'Find datasets, check access, manage your profile, and share conversations.' : 'Start with the basics, then follow a scenario end to end — the kind of job you actually run, shown step by step.'}
      </p>
    </div>
  </section>

  <section class="border-t border-rule">
    <div class="container-page py-8 md:py-12">
      <SectionMark kicker="Start here" numeral="I" title="The basics, in order." />
      <div class="grid gap-px overflow-hidden border border-rule sm:grid-cols-2 lg:grid-cols-3" style="background: var(--rule);">
        {docs.map((d) => (
          <a href={`/guides/${d.id}`} class="block p-7" style="background: var(--paper); text-decoration: none;">
            <div class="eyebrow mb-3" style="color: var(--shell);">{d.data.section}</div>
            <div class="font-display" style="font-variation-settings: 'SOFT' 40, 'opsz' 30; font-size: 1.2rem; line-height: 1.15; color: var(--ink);">{d.data.title}</div>
            <p class="mt-3 font-serif" style="font-size: 0.95rem; line-height: 1.55; font-variation-settings: 'opsz' 16; color: var(--ink-mute);">{d.data.description}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  {product === 'cowork' && (
  <section class="border-t border-rule" style="background: var(--paper-rim);">
    <div class="container-page py-20 md:py-24">
      <SectionMark kicker="Scenarios" numeral="II" title="Watch a full job run." />
      <p class="mb-10 max-w-2xl font-serif" style="font-size: 1.05rem; line-height: 1.6; font-variation-settings: 'opsz' 20; color: var(--ink);">
        Each scenario is a real LCA job from start to finish — the inputs, the decisions Cortex pauses on, and the deliverable it produces.
      </p>

      <p class="eyebrow mb-4" style="color: var(--shell);">For practitioners</p>
      <div class="grid gap-px overflow-hidden border border-rule sm:grid-cols-2 lg:grid-cols-3" style="background: var(--rule);">
        {practitioner.map((s) => (
          <a href={s.href} class="block p-7" style="background: var(--paper); text-decoration: none;">
            <div class="font-display" style="font-variation-settings: 'SOFT' 40, 'opsz' 30; font-size: 1.2rem; line-height: 1.15; color: var(--ink);">{s.label}</div>
            <p class="mt-3 font-serif" style="font-size: 0.95rem; line-height: 1.55; font-variation-settings: 'opsz' 16; color: var(--ink-mute);">{s.blurb}</p>
            <span class="mt-4 inline-block smallcaps" style="color: var(--shell);">Open →</span>
          </a>
        ))}
      </div>

      <p class="eyebrow mb-4 mt-12" style="color: var(--shell);">For programme operators</p>
      <div class="grid gap-px overflow-hidden border border-rule sm:grid-cols-2 lg:grid-cols-3" style="background: var(--rule);">
        {operator.map((s) => (
          <a href={s.href} class="block p-7" style="background: var(--paper); text-decoration: none;">
            <div class="font-display" style="font-variation-settings: 'SOFT' 40, 'opsz' 30; font-size: 1.2rem; line-height: 1.15; color: var(--ink);">{s.label}</div>
            <p class="mt-3 font-serif" style="font-size: 0.95rem; line-height: 1.55; font-variation-settings: 'opsz' 16; color: var(--ink-mute);">{s.blurb}</p>
            <span class="mt-4 inline-block smallcaps" style="color: var(--shell);">Open →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  )}
</BaseLayout>
