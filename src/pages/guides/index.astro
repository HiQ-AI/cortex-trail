---
import { getCollection } from 'astro:content';

const SECTION_ORDER = ['Start here', 'Workflows'];
const rank = (n: string) => {
  const i = SECTION_ORDER.indexOf(n);
  return i === -1 ? SECTION_ORDER.length : i;
};

const docs = await getCollection('docs', ({ data }) => data.locale === 'en');
const first = docs.sort(
  (a, b) => rank(a.data.section) - rank(b.data.section) || a.data.order - b.data.order,
)[0];

return Astro.redirect(first ? `/guides/${first.id}` : '/');
---
